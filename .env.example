# Polymarket — funded Polygon wallet (use a dedicated trading key, not your main one)
POLYMARKET_PK=0xYOUR_PRIVATE_KEY
POLYMARKET_FUNDER=0xYOUR_PROXY_OR_FUNDER_ADDRESS

# CLOB API credentials (run `python -m btc_news_poly.polymarket.client --derive-creds` once to generate)
POLYMARKET_API_KEY=
